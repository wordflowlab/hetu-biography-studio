{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 170
    },
    "brief": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8000
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 30
          },
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "name",
          "aliases",
          "description"
        ]
      },
      "maxItems": 100
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "byte_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "id",
          "label",
          "source_index",
          "byte_start",
          "byte_end",
          "quote"
        ]
      },
      "maxItems": 500
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "person_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 50
          },
          "kind": {
            "enum": [
              "birth",
              "death",
              "education",
              "work",
              "relationship",
              "move",
              "other"
            ]
          },
          "date_raw": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 50
          },
          "interpretation": {
            "type": "string",
            "minLength": 0,
            "maxLength": 8000
          }
        },
        "required": [
          "id",
          "title",
          "person_ids",
          "kind",
          "date_raw",
          "order",
          "evidence_ids",
          "interpretation"
        ]
      },
      "maxItems": 600
    },
    "identities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "person_a": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "person_b": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "relation": {
            "enum": [
              "same",
              "different",
              "uncertain"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 50
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "person_a",
          "person_b",
          "relation",
          "evidence_ids",
          "reason"
        ]
      },
      "maxItems": 200
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 100
          },
          "events_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          }
        },
        "required": [
          "id",
          "title",
          "order",
          "event_ids",
          "events_sha256",
          "text"
        ]
      },
      "maxItems": 200
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target_kind": {
            "enum": [
              "person",
              "event",
              "chapter"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "enum": [
              "author",
              "agent"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "target_kind",
          "target_id",
          "target_sha256",
          "origin",
          "comment",
          "status",
          "resolution"
        ]
      },
      "maxItems": 300
    },
    "basis_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner_plugin_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "owner_plugin_id",
          "object_id",
          "revision",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "format_version",
    "title",
    "brief",
    "people",
    "evidence",
    "events",
    "identities",
    "chapters",
    "notes",
    "basis_refs"
  ]
}
